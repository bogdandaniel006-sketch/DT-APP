{
  "name": "Lámina · Mesa de dibujo técnico",
  "short_name": "Lámina",
  "description": "Mesa de dibujo técnico digital. Hecho por Dani de Miguel.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/x-lamina": [".lamina"] }
    }
  ]
}
